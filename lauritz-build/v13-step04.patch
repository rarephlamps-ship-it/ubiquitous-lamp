+    @Test
+    fun learningDaoHasNoConclusionUpdateApi() {
+        val forbidden = LearningDao::class.java.methods.filter { method ->
+            method.name == "updateConclusion" ||
+                method.parameterTypes.any { it == dk.ruko.lauritz.data.intelligence.entities.AiConclusionEntity::class.java } &&
+                method.name.startsWith("update", ignoreCase = true)
+        }
+        assertTrue(forbidden.isEmpty())
+    }
+
+    @Test
