+package dk.ruko.lauritz.data.intelligence
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class KnowledgeVersionPolicyTest {
+    @Test
+    fun learnedComparisonAdvancesExactlyOneVersion() {
+        assertEquals(42L, KnowledgeVersionPolicy.next(41L, learnedSomething = true))
+    }
+
+    @Test
+    fun idempotentComparisonDoesNotInventVersion() {
+        assertEquals(41L, KnowledgeVersionPolicy.next(41L, learnedSomething = false))
+    }
+}
