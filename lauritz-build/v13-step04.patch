+        val draft = ConclusionDraft(
+            datasetId = "dataset",
+            lotId = "lot",
+            analysisRunId = 1L,
+            conclusion = AiConclusionClass.INCONCLUSIVE,
+            fakeProbability = 0.5,
+            confidence = 0.5,
+            evidenceQuality = 0.5,
+            anomalyScore = 0.5,
+            relistingProbability = null,
+            explanationJson = "{}",
+            referenceIdsJson = "[]",
+            supersedesConclusionId = null
+        )
+        assertEquals(null, draft.supersedesConclusionId)
+    }
+
 }
