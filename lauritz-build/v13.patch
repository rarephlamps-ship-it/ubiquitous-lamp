+package dk.ruko.lauritz.data.intelligence.entities
+
+import androidx.room.Entity
+import androidx.room.Index
+import androidx.room.PrimaryKey
+import dk.ruko.lauritz.intelligence.model.MarkKind
+import dk.ruko.lauritz.intelligence.model.ReferenceClassLabel
+import dk.ruko.lauritz.intelligence.model.ReferenceReviewStatus
+import dk.ruko.lauritz.intelligence.model.ReferenceScope
+import dk.ruko.lauritz.intelligence.model.ReferenceSourceKind
+import dk.ruko.lauritz.intelligence.model.ReferenceType
+import dk.ruko.lauritz.intelligence.model.RegionSelectionSource
+
+@Entity(
+    tableName = "mark_regions",
+    indices = [
+        Index(value = ["datasetId", "lotId"]),
+        Index(value = ["sourceImageSha256"]),
+        Index(value = ["markKind"])
+    ]
+)
+data class MarkRegionEntity(
+    @PrimaryKey(autoGenerate = true) val id: Long = 0,
+    val datasetId: String,
+    val lotId: String,
+    val imageStableId: String,
+    val sourceImageSha256: String,
+    val left: Double,
+    val top: Double,
+    val right: Double,
+    val bottom: Double,
+    val markKind: MarkKind,
+    val selectionSource: RegionSelectionSource,
+    val detectorVersion: String,
+    val createdUtc: Long
+) {
+    init {
+        requireUnitCoordinate("left", left)
+        requireUnitCoordinate("top", top)
+        requireUnitCoordinate("right", right)
+        requireUnitCoordinate("bottom", bottom)
+        require(left < right) { "left must be less than right" }
+        require(top < bottom) { "top must be less than bottom" }
+    }
+}
+
+@Entity(
+    tableName = "reference_entries",
+    indices = [
+        Index(value = ["scope", "datasetId", "referenceType"]),
+        Index(value = ["reviewStatus", "classLabel"]),
+        Index(value = ["inputSha256"]),
+        Index(value = ["featureVectorId"]),
+        Index(value = ["independenceGroupKey"])
+    ]
+)
+data class ReferenceEntryEntity(
+    @PrimaryKey(autoGenerate = true) val id: Long = 0,
+    val scope: ReferenceScope,
+    val datasetId: String?,
+    val referenceType: ReferenceType,
+    val subjectId: String,
+    val classLabel: ReferenceClassLabel,
+    val reviewStatus: ReferenceReviewStatus,
+    val sourceKind: ReferenceSourceKind,
+    val sourceRef: String,
+    val inputSha256: String,
+    val featureVectorId: Long,
+    val independenceGroupKey: String,
+    val createdUtc: Long,
+    val verifiedUtc: Long?,
+    val analystNote: String?
+) {
+    init {
+        require(scope != ReferenceScope.DATASET || datasetId != null) { "dataset-scoped reference requires datasetId" }
+        require(reviewStatus != ReferenceReviewStatus.ANALYST_VERIFIED || verifiedUtc != null) {
+            "verified reference requires verifiedUtc"
+        }
+    }
+}
+
+private fun requireUnitCoordinate(name: String, value: Double) {
+    require(value.isFinite() && value in 0.0..1.0) { "$name must be finite and in [0,1]" }
+}
