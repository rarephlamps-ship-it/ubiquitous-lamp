+
+class ConclusionHistoryPolicyTest {
+    @Test
+    fun aiConclusionVocabularyIsFixed() {
+        assertEquals(
+            setOf("LIKELY_AUTHENTIC", "LIKELY_FAKE", "INCONCLUSIVE"),
+            AiConclusionClass.entries.map { it.name }.toSet()
+        )
+    }
+
+    @Test
