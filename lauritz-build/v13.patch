+package dk.ruko.lauritz.data.intelligence.entities
+
+import androidx.room.Entity
+import androidx.room.Index
+import androidx.room.PrimaryKey
+import dk.ruko.lauritz.intelligence.model.FeatureKind
+import dk.ruko.lauritz.intelligence.model.FeatureSubjectType
+import dk.ruko.lauritz.intelligence.model.SimilarityEdgeType
+
+@Entity(
+    tableName = "feature_vectors",
+    indices = [
+        Index(value = ["datasetId", "subjectId"]),
+        Index(value = ["inputSha256", "extractorId", "extractorVersion", "featureKind"], unique = true)
+    ]
+)
+data class FeatureVectorEntity(
+    @PrimaryKey(autoGenerate = true) val id: Long = 0,
+    val datasetId: String,
+    val subjectType: FeatureSubjectType,
+    val subjectId: String,
+    val inputSha256: String,
+    val extractorId: String,
