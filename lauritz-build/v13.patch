+package dk.ruko.lauritz.data.intelligence.entities
+
+import androidx.room.Entity
+import androidx.room.Index
+import androidx.room.PrimaryKey
+import dk.ruko.lauritz.intelligence.model.AiConclusionClass
+import dk.ruko.lauritz.intelligence.model.AnalystConclusionStatus
+import dk.ruko.lauritz.intelligence.model.FeedbackActionType
+import dk.ruko.lauritz.intelligence.model.LearningComponent
+
+@Entity(
+    tableName = "ai_conclusions",
+    indices = [
+        Index(value = ["datasetId", "lotId", "createdUtc"]),
+        Index(value = ["datasetId", "conclusion"]),
+        Index(value = ["datasetId", "analystStatus"]),
+        Index(value = ["knowledgeVersion"])
+    ]
+)
+data class AiConclusionEntity(
+    @PrimaryKey(autoGenerate = true) val id: Long = 0,
+    val datasetId: String,
+    val lotId: String,
+    val analysisRunId: Long,
+    val conclusion: AiConclusionClass,
+    val fakeProbability: Double,
+    val confidence: Double,
+    val evidenceQuality: Double,
+    val anomalyScore: Double,
+    val relistingProbability: Double?,
+    val explanationJson: String,
+    val referenceIdsJson: String,
+    val knowledgeVersion: Long,
+    val createdUtc: Long,
+    val supersedesConclusionId: Long?,
+    val analystStatus: AnalystConclusionStatus,
+    val analystCorrection: String?
+) {
+    init {
+        requireUnitScore("fakeProbability", fakeProbability)
+        requireUnitScore("confidence", confidence)
+        requireUnitScore("evidenceQuality", evidenceQuality)
+        requireUnitScore("anomalyScore", anomalyScore)
+        requireNullableUnitScore("relistingProbability", relistingProbability)
+    }
+}
+
+@Entity(
+    tableName = "feedback_events",
+    indices = [
+        Index(value = ["datasetId", "lotId", "createdUtc"]),
+        Index(value = ["actionType", "explicit"]),
+        Index(value = ["subjectId"])
+    ]
+)
+data class FeedbackEventEntity(
+    @PrimaryKey(autoGenerate = true) val id: Long = 0,
+    val datasetId: String?,
+    val lotId: String?,
+    val subjectType: String?,
+    val subjectId: String?,
+    val actionType: FeedbackActionType,
+    val explicit: Boolean,
+    val payloadJson: String,
+    val learningWeight: Double,
+    val createdUtc: Long
+) {
+    init { require(learningWeight.isFinite() && learningWeight >= 0.0) { "learningWeight must be finite and non-negative" } }
+}
+
+@Entity(
+    tableName = "learning_state",
+    primaryKeys = ["scopeKey", "component"],
+    indices = [Index(value = ["knowledgeVersion"])]
+)
+data class LearningStateEntity(
+    val scopeKey: String,
+    val component: LearningComponent,
+    val knowledgeVersion: Long,
+    val parametersJson: String,
+    val sampleCount: Long,
+    val verifiedSampleCount: Long,
+    val calibrationError: Double?,
+    val updatedUtc: Long
+) {
+    init {
+        require(sampleCount >= 0) { "sampleCount must be non-negative" }
+        require(verifiedSampleCount >= 0 && verifiedSampleCount <= sampleCount) {
+            "verifiedSampleCount must be in [0,sampleCount]"
+        }
+        requireNullableUnitScore("calibrationError", calibrationError)
+    }
+}
+
+private fun requireUnitScore(name: String, score: Double) {
+    require(score.isFinite() && score in 0.0..1.0) { "$name must be finite and in [0,1]" }
+}
+
+private fun requireNullableUnitScore(name: String, score: Double?) {
+    if (score != null) requireUnitScore(name, score)
+}
