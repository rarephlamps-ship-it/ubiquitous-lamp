@@ -0,0 +1,54 @@
+package dk.ruko.lauritz.data.intelligence
+
+import android.content.Context
+import androidx.room.Database
+import androidx.room.Room
+import androidx.room.RoomDatabase
+import dk.ruko.lauritz.data.intelligence.entities.*
+
+@Database(
+    entities = [
+        DatasetKnowledgeEntity::class,
+        ModelRegistryEntryEntity::class,
+        AnalysisRunEntity::class,
+        KnowledgeSnapshotEntity::class,
+        FeatureVectorEntity::class,
+        ObjectFingerprintEntity::class,
+        ComparisonEventEntity::class,
+        SimilarityEdgeEntity::class,
+        ClusterEntity::class,
+        ClusterMemberEntity::class,
+        WatchPatternEntity::class,
+        AiConclusionEntity::class,
+        FeedbackEventEntity::class,
+        LearningStateEntity::class,
+        MarkRegionEntity::class,
+        ReferenceEntryEntity::class,
+        OsintLeadEntity::class,
+        CloudTransmissionEntity::class
+    ],
+    version = 1,
+    exportSchema = false
+)
+abstract class IntelligenceDatabase : RoomDatabase() {
+    abstract fun knowledge(): KnowledgeDao
+    abstract fun features(): FeatureDao
+    abstract fun clusters(): ClusterDao
+    abstract fun learning(): LearningDao
+    abstract fun references(): ReferenceDao
+    abstract fun externalAudit(): ExternalAuditDao
+
+    companion object {
+        const val NAME = "intelligence.sqlite"
+        @Volatile private var instance: IntelligenceDatabase? = null
+
+        fun get(context: Context): IntelligenceDatabase =
+            instance ?: synchronized(this) {
+                instance ?: Room.databaseBuilder(
+                    context.applicationContext,
+                    IntelligenceDatabase::class.java,
+                    NAME
+                ).build().also { instance = it }
+            }
+    }
+}
