+package dk.ruko.lauritz.data.intelligence
+
+import dk.ruko.lauritz.intelligence.model.AiConclusionClass
+import dk.ruko.lauritz.intelligence.model.AnalystConclusionStatus
+import dk.ruko.lauritz.intelligence.model.ConclusionDraft
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class ConclusionHistoryPolicyTest {
+    @Test
+    fun aiConclusionVocabularyIsFixed() {
+        assertEquals(
+            setOf("LIKELY_AUTHENTIC", "LIKELY_FAKE", "INCONCLUSIVE"),
+            AiConclusionClass.entries.map { it.name }.toSet()
+        )
+    }
+
+    @Test
+    fun analystStatusIsSeparateFromAiClass() {
+        assertTrue("CONFIRMED" in AnalystConclusionStatus.entries.map { it.name })
+        assertFalse("CONFIRMED" in AiConclusionClass.entries.map { it.name })
+    }
+
+    @Test(expected = IllegalArgumentException::class)
+    fun conclusionDraftRejectsConfidenceAboveOne() {
+        ConclusionDraft(
+            datasetId = "dataset",
+            lotId = "lot",
+            analysisRunId = 1L,
+            conclusion = AiConclusionClass.INCONCLUSIVE,
+            fakeProbability = 0.5,
+            confidence = 1.01,
+            evidenceQuality = 0.5,
+            anomalyScore = 0.5,
+            relistingProbability = null,
+            explanationJson = "{}",
+            referenceIdsJson = "[]",
+            supersedesConclusionId = null
+        )
+    }
+}
