+    init { requireUnitScore("quality", quality) }
+}
+
+@Entity(
+    tableName = "object_fingerprints",
+    indices = [
+        Index(value = ["datasetId", "lotId", "knowledgeVersion"]),
+        Index(value = ["independenceGroupKey"])
+    ]
+)
+data class ObjectFingerprintEntity(
+    @PrimaryKey(autoGenerate = true) val id: Long = 0,
+    val datasetId: String,
+    val lotId: String,
+    val fingerprintVersion: String,
+    val imageFeatureIdsJson: String,
+    val metadataFeatureId: Long?,
+    val normalizedIdentityJson: String,
+    val independenceGroupKey: String,
+    val createdUtc: Long,
+    val knowledgeVersion: Long
+)
+
+@Entity(
+    tableName = "comparison_events",
+    indices = [
+        Index(value = ["datasetId", "createdUtc"]),
+        Index(value = ["datasetId", "subjectAId"]),
+        Index(value = ["datasetId", "subjectBId"]),
+        Index(value = ["analysisRunId"]),
+        Index(value = ["knowledgeVersionAfter"])
+    ]
+)
+data class ComparisonEventEntity(
+    @PrimaryKey(autoGenerate = true) val id: Long = 0,
+    val datasetId: String,
+    val subjectAType: String,
+    val subjectAId: String,
+    val subjectBType: String,
+    val subjectBId: String,
+    val similarityScore: Double,
+    val visualScore: Double?,
+    val markScore: Double?,
+    val metadataScore: Double?,
+    val relationshipScore: Double?,
+    val reasonJson: String,
+    val analysisRunId: Long,
+    val knowledgeVersionBefore: Long,
+    val knowledgeVersionAfter: Long,
+    val createdUtc: Long
+) {
+    init {
+        requireUnitScore("similarityScore", similarityScore)
+        requireNullableUnitScore("visualScore", visualScore)
+        requireNullableUnitScore("markScore", markScore)
+        requireNullableUnitScore("metadataScore", metadataScore)
+        requireNullableUnitScore("relationshipScore", relationshipScore)
+    }
+}
+
+@Entity(
+    tableName = "similarity_edges",
+    primaryKeys = ["datasetId", "leftSubjectId", "rightSubjectId", "edgeType"],
+    indices = [
+        Index(value = ["datasetId", "edgeType", "score"]),
+        Index(value = ["independenceGroupKey"]),
+        Index(value = ["knowledgeVersion"])
+    ]
+)
+data class SimilarityEdgeEntity(
+    val datasetId: String,
+    val leftSubjectId: String,
+    val rightSubjectId: String,
+    val edgeType: SimilarityEdgeType,
+    val score: Double,
+    val independenceGroupKey: String,
+    val featureVersion: String,
+    val knowledgeVersion: Long,
+    val createdUtc: Long
+) {
+    init { requireUnitScore("score", score) }
+}
+
+private fun requireUnitScore(name: String, score: Double) {
+    require(score.isFinite() && score in 0.0..1.0) { "$name must be finite and in [0,1]" }
+}
+
+private fun requireNullableUnitScore(name: String, score: Double?) {
+    if (score != null) requireUnitScore(name, score)
+}
