@@ -0,0 +1,127 @@
+package dk.ruko.lauritz.data.intelligence
+
+import androidx.room.Dao
+import androidx.room.Insert
+import androidx.room.OnConflictStrategy
+import androidx.room.Query
+import androidx.room.Update
+import dk.ruko.lauritz.data.intelligence.entities.*
+
+@Dao
+interface KnowledgeDao {
+    @Query("SELECT * FROM dataset_knowledge WHERE datasetId=:datasetId")
+    suspend fun dataset(datasetId: String): DatasetKnowledgeEntity?
+
+    @Insert(onConflict = OnConflictStrategy.IGNORE)
+    suspend fun insertDataset(row: DatasetKnowledgeEntity): Long
+
+    @Update
+    suspend fun updateDataset(row: DatasetKnowledgeEntity)
+
+    @Insert
+    suspend fun insertSnapshot(row: KnowledgeSnapshotEntity): Long
+
+    @Insert(onConflict = OnConflictStrategy.REPLACE)
+    suspend fun upsertModel(row: ModelRegistryEntryEntity)
+
+    @Insert
+    suspend fun insertRun(row: AnalysisRunEntity): Long
+
+    @Query("SELECT * FROM analysis_runs WHERE id=:id")
+    suspend fun run(id: Long): AnalysisRunEntity?
+
+    @Update
+    suspend fun updateRun(row: AnalysisRunEntity)
+}
+
+@Dao
+interface FeatureDao {
+    @Insert(onConflict = OnConflictStrategy.IGNORE)
+    suspend fun insertFeature(row: FeatureVectorEntity): Long
+
+    @Query("""
+        SELECT * FROM feature_vectors
+        WHERE inputSha256=:sha AND extractorId=:extractorId
+          AND extractorVersion=:version AND featureKind=:kind
+        LIMIT 1
+    """)
+    suspend fun featureByContent(
+        sha: String,
+        extractorId: String,
+        version: String,
+        kind: String
+    ): FeatureVectorEntity?
+
+    @Insert
+    suspend fun insertFingerprint(row: ObjectFingerprintEntity): Long
+
+    @Insert
+    suspend fun insertComparison(row: ComparisonEventEntity): Long
+
+    @Insert(onConflict = OnConflictStrategy.REPLACE)
+    suspend fun upsertSimilarity(row: SimilarityEdgeEntity)
+}
+
+@Dao
+interface ClusterDao {
+    @Insert
+    suspend fun insertCluster(row: ClusterEntity): Long
+
+    @Insert(onConflict = OnConflictStrategy.REPLACE)
+    suspend fun upsertMember(row: ClusterMemberEntity)
+
+    @Insert
+    suspend fun insertWatchPattern(row: WatchPatternEntity): Long
+
+    @Update
+    suspend fun updateWatchPattern(row: WatchPatternEntity)
+}
+
+@Dao
+interface LearningDao {
+    @Insert
+    suspend fun insertConclusion(row: AiConclusionEntity): Long
+
+    @Query("SELECT * FROM ai_conclusions WHERE id=:id")
+    suspend fun conclusion(id: Long): AiConclusionEntity?
+
+    @Query("""
+        SELECT * FROM ai_conclusions
+        WHERE datasetId=:datasetId AND lotId=:lotId
+        ORDER BY createdUtc DESC,id DESC LIMIT 1
+    """)
+    suspend fun latestConclusion(datasetId: String, lotId: String): AiConclusionEntity?
+
+    @Insert
+    suspend fun insertFeedback(row: FeedbackEventEntity): Long
+
+    @Insert(onConflict = OnConflictStrategy.REPLACE)
+    suspend fun upsertState(row: LearningStateEntity)
+}
+
+@Dao
+interface ReferenceDao {
+    @Insert
+    suspend fun insertMarkRegion(row: MarkRegionEntity): Long
+
+    @Insert
+    suspend fun insertReference(row: ReferenceEntryEntity): Long
+
+    @Query("SELECT * FROM reference_entries WHERE id=:id")
+    suspend fun reference(id: Long): ReferenceEntryEntity?
+
+    @Update
+    suspend fun updateReference(row: ReferenceEntryEntity)
+}
+
+@Dao
+interface ExternalAuditDao {
+    @Insert
+    suspend fun insertOsintLead(row: OsintLeadEntity): Long
+
+    @Update
+    suspend fun updateOsintLead(row: OsintLeadEntity)
+
+    @Insert
+    suspend fun insertCloudTransmission(row: CloudTransmissionEntity): Long
+}
