+package dk.ruko.lauritz.data.intelligence.entities
+
+import androidx.room.Entity
+import androidx.room.Index
+import androidx.room.PrimaryKey
+import dk.ruko.lauritz.intelligence.model.ClusterType
+import dk.ruko.lauritz.intelligence.model.ReferenceScope
+import dk.ruko.lauritz.intelligence.model.WatchPatternType
+
+@Entity(
+    tableName = "clusters",
+    indices = [
+        Index(value = ["datasetId", "clusterType", "knowledgeVersion"]),
+        Index(value = ["datasetId", "createdUtc"])
+    ]
+)
+data class ClusterEntity(
+    @PrimaryKey(autoGenerate = true) val id: Long = 0,
+    val datasetId: String,
+    val clusterType: ClusterType,
+    val algorithmVersion: String,
+    val label: String?,
+    val summaryJson: String,
+    val knowledgeVersion: Long,
+    val createdUtc: Long
+)
+
+@Entity(
+    tableName = "cluster_members",
+    primaryKeys = ["clusterId", "subjectType", "subjectId"],
+    indices = [Index(value = ["subjectId"]), Index(value = ["independenceGroupKey"])]
+)
+data class ClusterMemberEntity(
+    val clusterId: Long,
+    val subjectType: String,
+    val subjectId: String,
+    val membershipScore: Double,
+    val independenceGroupKey: String
+) {
+    init { requireUnitScore("membershipScore", membershipScore) }
+}
+
+@Entity(
+    tableName = "watch_patterns",
+    indices = [
+        Index(value = ["scope", "datasetId", "enabled"]),
+        Index(value = ["referenceSubjectId"])
+    ]
+)
+data class WatchPatternEntity(
+    @PrimaryKey(autoGenerate = true) val id: Long = 0,
+    val scope: ReferenceScope,
+    val datasetId: String?,
+    val patternType: WatchPatternType,
+    val referenceSubjectId: String,
+    val threshold: Double,
+    val enabled: Boolean,
+    val createdUtc: Long,
+    val lastTriggeredUtc: Long?
+) {
+    init {
+        requireUnitScore("threshold", threshold)
+        require(scope != ReferenceScope.DATASET || datasetId != null) { "dataset-scoped watch pattern requires datasetId" }
+    }
+}
+
+private fun requireUnitScore(name: String, score: Double) {
+    require(score.isFinite() && score in 0.0..1.0) { "$name must be finite and in [0,1]" }
+}
