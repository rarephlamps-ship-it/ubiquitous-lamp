@@ -0,0 +1,22 @@
+package dk.ruko.lauritz.intelligence.model
+
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonElement
+import kotlinx.serialization.json.JsonObject
+import java.security.MessageDigest
+
+object IntelligenceJson {
+    val codec = Json {
+        encodeDefaults = true
+        explicitNulls = true
+        ignoreUnknownKeys = false
+        prettyPrint = false
+    }
+
+    fun canonicalObject(values: Map<String, JsonElement>): String =
+        JsonObject(values.toSortedMap()).toString()
+
+    fun sha256Utf8(value: String): String = MessageDigest.getInstance("SHA-256")
+        .digest(value.toByteArray(Charsets.UTF_8))
+        .joinToString("") { "%02x".format(it) }
+}
